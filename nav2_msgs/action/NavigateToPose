#include "rclcpp_action/rclcpp_action.hpp"
#include "nav2_msgs/action/navigate_to_pose.hpp"

// 목적지 이름에 따른 (x, y) 좌표 매핑
geometry_msgs::msg::PoseStamped getGoalPose(const std::string& destination) {
    geometry_msgs::msg::PoseStamped goal;
    goal.header.frame_id = "map";
    goal.header.stamp = rclcpp::Clock().now();

    if (destination == "301") {
        goal.pose.position.x = 2.0;  // 원하는 Gazebo 월드 내 x 좌표
        goal.pose.position.y = 1.5;  // 원하는 Gazebo 월드 내 y 좌표
        goal.pose.orientation.w = 1.0;
    } else if (destination == "Station_A") {
        goal.pose.position.x = -1.0;
        goal.pose.position.y = 0.5;
        goal.pose.orientation.w = 1.0;
    }
    return goal;
}