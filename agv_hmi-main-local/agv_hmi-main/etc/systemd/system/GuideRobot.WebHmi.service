[Unit]
Description=GuideRobot Blazor Web HMI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# 배포한 publish 폴더 위치에 맞춰 두 값을 유지합니다.
WorkingDirectory=/opt/guiderobot/webhmi
ExecStart=/usr/bin/dotnet /opt/guiderobot/webhmi/GuideRobot.WebHmi.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=guide-robot-webhmi
User=guiderobot
Group=guiderobot

# Production에서는 appsettings.Development.json이 로드되지 않으므로 반드시 필요합니다.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=RobotServer__BaseUrl=http://127.0.0.1:8080/
Environment=DOTNET_NOLOGO=1

# 웹앱이 외부에 직접 노출되지 않도록 Kestrel은 loopback만 사용합니다.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
